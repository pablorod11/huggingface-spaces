# Examples only; export real random values in your shell or use Space Secrets.
# APP_ACCESS_KEY must have at least 24 characters.
# APP_SECRET_KEY must have at least 32 characters, different from the access key.
APP_ACCESS_KEY=
APP_SECRET_KEY=
WORKSPACE_NAME=Security operations
DATA_DIR=./data
# Set false ONLY for loopback HTTP development.
COOKIE_SECURE=true
